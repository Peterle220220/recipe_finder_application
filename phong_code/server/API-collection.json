          "body": {
            "contentType": "application/json",
            "body": "{\n  \"title\": \"Delicious Pasta Carbonara\",\n  \"description\": \"A classic Italian pasta dish with creamy egg sauce, pancetta and cheese.\",\n  \"ingredients\": [\n    {\n      \"name\": \"spaghetti\",\n      \"amount\": \"400\",\n      \"unit\": \"g\"\n    },\n    {\n      \"name\": \"pancetta\",\n      \"amount\": \"150\",\n      \"unit\": \"g\"\n    },\n    {\n      \"name\": \"eggs\",\n      \"amount\": \"3\",\n      \"unit\": \"whole\"\n    },\n    {\n      \"name\": \"egg yolks\",\n      \"amount\": \"1\",\n      \"unit\": \"whole\"\n    },\n    {\n      \"name\": \"parmesan cheese\",\n      \"amount\": \"50\",\n      \"unit\": \"g\"\n    },\n    {\n      \"name\": \"black pepper\",\n      \"amount\": \"1\",\n      \"unit\": \"tsp\"\n    }\n  ],\n  \"steps\": [\n    {\n      \"description\": \"Bring a large pot of salted water to boil and cook the pasta until al dente.\",\n      \"image\": \"\"\n    },\n    {\n      \"description\": \"While pasta is cooking, fry the pancetta in a large pan until crispy.\",\n      \"image\": \"\"\n    },\n    {\n      \"description\": \"In a bowl, whisk together eggs, egg yolk, grated cheese, and black pepper.\",\n      \"image\": \"\"\n    },\n    {\n      \"description\": \"Drain the pasta, reserving a little pasta water. Add pasta to the pancetta pan while still hot.\",\n      \"image\": \"\"\n    },\n    {\n      \"description\": \"Remove pan from heat, add egg mixture and toss quickly to create a creamy sauce.\",\n      \"image\": \"\"\n    }\n  ],\n  \"prepTime\": 10,\n  \"cookTime\": 15,\n  \"servings\": 4,\n  \"difficulty\": \"Medium\",\n  \"cuisine\": \"Italian\",\n  \"category\": \"Main Course\",\n  \"tags\": [\"pasta\", \"quick dinner\", \"Italian\"],\n  \"mainImage\": \"/uploads/1683975644386.jpg\",\n  \"nutrition\": {\n    \"calories\": \"550\",\n    \"protein\": \"22g\",\n    \"carbs\": \"67g\",\n    \"fat\": \"18g\",\n    \"sodium\": \"930mg\",\n    \"fiber\": \"3g\"\n  },\n  \"notes\": \"For an authentic carbonara, never use cream! The creaminess comes from the eggs and cheese.\",\n  \"isPublic\": true\n}"
